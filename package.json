{
	"name": "mtc-bridge",
	"version": "2.4.0",
	"description": "MetaCoin Birgde",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "http://metacoin.network"
	},
	"author": "Inblock",
	"keywords": [
		"MetaCoin",
		"MTC"
	],
	"dependencies": {
		"body-parser": "^1.20.0",
		"crc": "^4.3.2",
		"express": "^4.18.1",
		"fabric-ca-client": "^2.2.13",
		"fabric-client": "^1.4.20",
		"grpc": "^1.24.11",
		"ioredis": "^5.2.4",
		"md5": "^2.3.0",
		"multer": "^1.4.4",
		"promise": "^8.1.0",
		"winston": "^2.4.7"
	},
	"eslintConfig": {
		"root": true,
		"env": {
			"node": true
		},
		"extends": [
			"eslint:recommended"
		],
		"parserOptions": {
			"ecmaVersion": 2015,
			"parser": "babel-eslint",
			"sourceType": "module"
		},
		"rules": {
			"no-unused-vars": [
				"warn",
				{
					"vars": "all"
				}
			]
		}
	},
	"engines": {
		"node": ">=16.0.0"
	}
}